# FastAPI Backend Environment Variables
# Copy this file to .env for local development. NEVER COMMIT .env!

# Supabase Local Stack
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=fake_service_role_key

# Payment Gateway (Safepay Sandbox / Stub)
PAYMENT_GATEWAY=stub
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=fake_safepay_key
SAFEPAY_WEBHOOK_SECRET=fake_safepay_webhook_secret

# Video (LiveKit)
LIVEKIT_API_KEY=fake_livekit_key
LIVEKIT_API_SECRET=fake_livekit_secret

# Email (Resend)
RESEND_API_KEY=fake_resend_key

# Sentry
SENTRY_DSN=

# Testing & Fault Injection (NEVER ENABLE IN PRODUCTION)
FAULT_INJECTION_ENABLED=false
